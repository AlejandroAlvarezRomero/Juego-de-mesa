# --- Copia este archivo como `.env` en la MISMA carpeta que docker-compose.yml ---
#     Copy-Item .env.example .env
#
# Docker Compose lee automáticamente este `.env` para la interpolación de variables.

# --- OBLIGATORIO: clave de firma de los JWT ---
# Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Si no se define, `docker compose up` falla y el backend también se niega a
# arrancar en modo production (fail-fast) en lugar de usar la clave por defecto.
JWT_SECRET_KEY=

# --- Base de datos (definida dentro de docker-compose.yml) ---
# DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/boardgames

# --- Otros ajustes opcionales ---
# ENVIRONMENT=production
# COOKIE_SECURE=False
# COOKIE_SAMESITE=lax
# RATE_LIMIT_BACKEND=auto
# REDIS_URL=redis://redis:6379/0
# CORS_ORIGINS=["http://localhost","http://localhost:80","http://127.0.0.1"]
